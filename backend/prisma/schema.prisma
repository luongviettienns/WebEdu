generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  PENDING_CLASS
  ACTIVE
  INACTIVE
}

enum CourseLevel {
  HSK1
  HSK2
  HSK3
  HSK4
  BASIC_COMMUNICATION
}

enum ClassStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  DROPPED
  COMPLETED
}

enum SessionType {
  REGULAR
  MANUAL
  MAKEUP
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum SessionChangeAction {
  GENERATE
  UPDATE_RECURRING_RULE
  ADD_MANUAL
  RESCHEDULE
  CANCEL
  ADD_MAKEUP
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

model User {
  id                  String      @id @default(uuid())
  email               String      @unique @db.VarChar(255)
  phone               String      @unique @db.VarChar(15)
  fullName            String      @map("full_name") @db.VarChar(100)
  passwordHash        String      @map("password_hash") @db.VarChar(255)
  roles               Role[]      @default([STUDENT])
  status              UserStatus  @default(PENDING_CLASS)
  failedLoginAttempts Int         @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?   @map("locked_until") @db.Timestamptz(3)
  tokenVersion        Int         @default(0) @map("token_version")
  lastLoginAt         DateTime?   @map("last_login_at") @db.Timestamptz(3)
  lastActivityAt      DateTime?   @map("last_activity_at") @db.Timestamptz(3)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  studentProfile      StudentProfile?
  teacherProfile      TeacherProfile?
  passwordResetTokens PasswordResetToken[]
  auditLogsAsActor    SystemAuditLog[]     @relation("AuditActor")
  taughtClasses             Class[]                  @relation("ClassTeacher")
  enrollments               Enrollment[]             @relation("StudentEnrollments")
  teacherAssignments        ClassTeacherAssignment[] @relation("TeacherAssignmentHistory")
  changedTeacherAssignments ClassTeacherAssignment[] @relation("TeacherAssignmentActor")
  cancelledSessions         LessonSession[]          @relation("SessionCancelledBy")
  markedAttendanceSessions  LessonSession[]          @relation("SessionAttendanceMarker")
  sessionChangeLogs         SessionChangeLog[]       @relation("SessionChangeActor")
  attendanceRecords         AttendanceRecord[]       @relation("StudentAttendanceRecords")
  markedAttendances         AttendanceRecord[]       @relation("AttendanceMarkedBy")
  updatedAttendances        AttendanceRecord[]       @relation("AttendanceUpdatedBy")
  studentAttendanceAudits   AttendanceAuditLog[]     @relation("AttendanceAuditStudent")
  actedAttendanceAudits     AttendanceAuditLog[]     @relation("AttendanceAuditActor")

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([fullName])
  @@map("users")
}

model StudentProfile {
  id             String           @id @default(uuid())
  userId         String           @unique @map("user_id")
  dateOfBirth    DateTime         @map("date_of_birth") @db.Date
  guardianEmail  String?          @map("guardian_email") @db.VarChar(255)
  // Materialized read-model cache synced atomically inside Enrollment transactions from the student's ACTIVE Enrollment (or initial placement).
  assignedClass  String?          @map("assigned_class") @db.VarChar(100)
  // Materialized FK synced atomically inside Enrollment transactions with the student's ACTIVE Enrollment.classId.
  currentClassId String?          @map("current_class_id")
  internalNotes  String?          @map("internal_notes") @db.Text
  enrolledAt     DateTime?        @map("enrolled_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  consent        GuardianConsent?
  currentClass   Class?           @relation("CurrentStudentClass", fields: [currentClassId], references: [id], onDelete: Restrict)

  @@index([guardianEmail])
  @@index([assignedClass])
  @@index([currentClassId])
  @@map("student_profiles")
}

// Immutable point-in-time consent record for an under-16 registration (1 student_profile -> max 1 initial guardian consent;
// enforced append-only in PostgreSQL via trg_guardian_consents_immutable so >= 16 User.email edits never overwrite consent history).
model GuardianConsent {
  id                  String         @id @default(uuid())
  studentProfileId    String         @unique @map("student_profile_id")
  guardianEmail       String         @map("guardian_email") @db.VarChar(255)
  consented           Boolean        @default(true)
  consentVersion      String         @map("consent_version") @db.VarChar(20)
  consentTextSnapshot String         @map("consent_text_snapshot") @db.Text
  ipAddress           String?        @map("ip_address") @db.VarChar(64)
  userAgent           String?        @map("user_agent") @db.VarChar(500)
  consentedAt         DateTime       @default(now()) @map("consented_at") @db.Timestamptz(3)

  studentProfile      StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)

  @@map("guardian_consents")
}

model TeacherProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  notes              String?  @db.Text
  // Materialized counter maintained in-DB by PostgreSQL trigger trg_classes_sync_teacher_active_count (UPCOMING + ACTIVE classes).
  activeClassesCount Int      @default(0) @map("active_classes_count")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("teacher_profiles")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailRateLimit {
  emailHash       String   @id @map("email_hash") @db.VarChar(64)
  lastRequestedAt DateTime @map("last_requested_at") @db.Timestamptz(3)

  @@index([lastRequestedAt])
  @@map("email_rate_limits")
}

model EmailVerification {
  id         String    @id @default(uuid())
  email      String    @db.VarChar(255)
  codeHash   String    @map("code_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("email_verifications")
}

model AuthRateLimit {
  key           String    @id @map("key") @db.VarChar(128)
  points        Int       @default(1)
  lastAttemptAt DateTime  @map("last_attempt_at") @db.Timestamptz(3)
  blockedUntil  DateTime? @map("blocked_until") @db.Timestamptz(3)

  @@index([lastAttemptAt])
  @@map("auth_rate_limits")
}

model Course {
  id              String      @id @default(uuid())
  code            String      @unique @db.VarChar(30)
  name            String      @db.VarChar(150)
  level           CourseLevel
  defaultSessions Int?        @map("default_sessions")
  description     String?     @db.Text
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  classes         Class[]

  @@index([isActive, level])
  @@map("courses")
}

model Class {
  id                String                   @id @default(uuid())
  code              String                   @unique @db.VarChar(20)
  courseId          String                   @map("course_id")
  // Denormalized current lead teacher pointer synced atomically inside assignment transactions with the open ClassTeacherAssignment (assignedTo IS NULL).
  teacherId         String                   @map("teacher_id")
  status            ClassStatus              @default(UPCOMING)
  startDate         DateTime                 @map("start_date") @db.Date
  totalSessions     Int                      @default(24) @map("total_sessions")
  scheduleDays      Int[]                    @default([1, 3, 5]) @map("schedule_days")
  scheduleStartTime String                   @default("18:00") @map("schedule_start_time") @db.VarChar(5)
  scheduleEndTime   String                   @default("19:30") @map("schedule_end_time") @db.VarChar(5)
  expectedEndDate   DateTime?                @map("expected_end_date") @db.Date
  actualEndDate     DateTime?                @map("actual_end_date") @db.Date
  closedReason      String?                  @map("closed_reason") @db.VarChar(255)
  closedAt          DateTime?                @map("closed_at") @db.Timestamptz(3)
  notes             String?                  @db.Text
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  course            Course                   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  teacher           User                     @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  enrollments       Enrollment[]
  currentStudents   StudentProfile[]         @relation("CurrentStudentClass")
  teacherHistory    ClassTeacherAssignment[]
  sessions          LessonSession[]
  sessionChangeLogs SessionChangeLog[]
  attendanceRecords AttendanceRecord[]

  @@index([teacherId, status])
  @@index([courseId])
  @@index([status])
  @@map("classes")
}

model ClassTeacherAssignment {
  id           String    @id @default(uuid())
  classId      String    @map("class_id")
  teacherId    String    @map("teacher_id")
  assignedFrom DateTime  @map("assigned_from") @db.Date
  assignedTo   DateTime? @map("assigned_to") @db.Date
  changedById  String?   @map("changed_by_id")
  reason       String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  class        Class     @relation(fields: [classId], references: [id], onDelete: Restrict)
  teacher      User      @relation("TeacherAssignmentHistory", fields: [teacherId], references: [id], onDelete: Restrict)
  changedBy    User?     @relation("TeacherAssignmentActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([classId, assignedFrom(sort: Desc)])
  @@index([teacherId])
  @@map("class_teacher_assignments")
}

model Enrollment {
  id           String           @id @default(uuid())
  classId      String           @map("class_id")
  studentId    String           @map("student_id")
  status       EnrollmentStatus @default(ACTIVE)
  enrolledDate DateTime         @map("enrolled_date") @db.Date
  leftDate     DateTime?        @map("left_date") @db.Date
  reason       String?          @db.Text
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  class        Class            @relation(fields: [classId], references: [id], onDelete: Restrict)
  student      User             @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Restrict)

  @@index([classId, status])
  @@index([studentId, status])
  @@map("enrollments")
}

model SystemAuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actingRole Role?    @map("acting_role")
  action     String   @db.VarChar(100)
  targetType String   @map("target_type") @db.VarChar(100)
  targetId   String?  @map("target_id") @db.VarChar(100)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorId])
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@map("system_audit_logs")
}

model LessonSession {
  id                   String        @id @default(uuid())
  classId              String        @map("class_id")
  sessionNumber        Int?          @map("session_number")
  type                 SessionType   @default(REGULAR)
  sessionDate          DateTime      @map("session_date") @db.Date
  startTime            String        @map("start_time") @db.VarChar(5)
  endTime              String        @map("end_time") @db.VarChar(5)
  status               SessionStatus @default(SCHEDULED)
  isRescheduled        Boolean       @default(false) @map("is_rescheduled")
  isMakeup             Boolean       @default(false) @map("is_makeup")
  makeupForSessionId   String?       @unique @map("makeup_for_session_id")
  topic                String?       @db.VarChar(255)
  cancelReason         String?       @map("cancel_reason") @db.Text
  cancelledById        String?       @map("cancelled_by_id")
  cancelledAt          DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  attendanceMarkedById String?       @map("attendance_marked_by_id")
  attendanceMarkedAt   DateTime?     @map("attendance_marked_at") @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  class              Class                @relation(fields: [classId], references: [id], onDelete: Restrict)
  makeupForSession   LessonSession?       @relation("MakeupSessionLink", fields: [makeupForSessionId], references: [id], onDelete: Restrict)
  makeupReplacement  LessonSession?       @relation("MakeupSessionLink")
  cancelledBy        User?                @relation("SessionCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  attendanceMarkedBy User?                @relation("SessionAttendanceMarker", fields: [attendanceMarkedById], references: [id], onDelete: SetNull)
  changeLogs         SessionChangeLog[]
  attendanceRecords  AttendanceRecord[]
  attendanceAudits   AttendanceAuditLog[]

  @@index([classId, sessionDate, startTime])
  @@index([sessionDate, status])
  @@map("lesson_sessions")
}

model SessionChangeLog {
  id                String              @id @default(uuid())
  classId           String              @map("class_id")
  sessionId         String?             @map("session_id")
  action            SessionChangeAction
  actorId           String              @map("actor_id")
  actorName         String              @map("actor_name") @db.VarChar(100)
  previousDate      DateTime?           @map("previous_date") @db.Date
  previousStartTime String?             @map("previous_start_time") @db.VarChar(5)
  previousEndTime   String?             @map("previous_end_time") @db.VarChar(5)
  newDate           DateTime?           @map("new_date") @db.Date
  newStartTime      String?             @map("new_start_time") @db.VarChar(5)
  newEndTime        String?             @map("new_end_time") @db.VarChar(5)
  reason            String              @db.Text
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  class   Class          @relation(fields: [classId], references: [id], onDelete: Restrict)
  session LessonSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  actor   User           @relation("SessionChangeActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([classId, createdAt(sort: Desc)])
  @@index([sessionId])
  @@index([actorId])
  @@index([createdAt(sort: Desc)])
  @@map("session_change_logs")
}

model AttendanceRecord {
  id          String           @id @default(uuid())
  sessionId   String           @map("session_id")
  classId     String           @map("class_id")
  studentId   String           @map("student_id")
  status      AttendanceStatus
  note        String?          @db.VarChar(255)
  markedById  String           @map("marked_by_id")
  markedAt    DateTime         @default(now()) @map("marked_at") @db.Timestamptz(3)
  updatedById String?          @map("updated_by_id")
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  session   LessonSession        @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  class     Class                @relation(fields: [classId], references: [id], onDelete: Restrict)
  student   User                 @relation("StudentAttendanceRecords", fields: [studentId], references: [id], onDelete: Restrict)
  markedBy  User                 @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: Restrict)
  updatedBy User?                @relation("AttendanceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  auditLogs AttendanceAuditLog[]

  @@unique([sessionId, studentId])
  @@index([classId, studentId, status])
  @@index([studentId])
  @@map("attendance_records")
}

model AttendanceAuditLog {
  id                 String           @id @default(uuid())
  attendanceRecordId String           @map("attendance_record_id")
  sessionId          String           @map("session_id")
  studentId          String           @map("student_id")
  previousStatus     AttendanceStatus @map("previous_status")
  newStatus          AttendanceStatus @map("new_status")
  previousNote       String?          @map("previous_note") @db.VarChar(255)
  newNote            String?          @map("new_note") @db.VarChar(255)
  reason             String           @db.Text
  actorId            String           @map("actor_id")
  actorRole          Role             @map("actor_role")
  isAdminOverride    Boolean          @default(false) @map("is_admin_override")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  session          LessonSession    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student          User             @relation("AttendanceAuditStudent", fields: [studentId], references: [id], onDelete: Restrict)
  actor            User             @relation("AttendanceAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([sessionId, createdAt(sort: Desc)])
  @@index([studentId, createdAt(sort: Desc)])
  @@index([attendanceRecordId])
  @@map("attendance_audit_logs")
}
