# Application
PORT=3001
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh
CORS_ORIGIN=http://localhost:3000
FRONTEND_APP_URL=http://localhost:3000

# Database (PostgreSQL 16+)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/webedu?schema=public

# Security
JWT_SECRET=replace_this_with_a_secure_random_key_min_32_characters

# Email / Password Reset (SMTP — e.g. Mailpit/MailHog locally on port 1025, or production SMTP relay)
MAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Trung Tâm TD Hán Ngữ <no-reply@webedu.local>"
