# Application
PORT=3001
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh
CORS_ORIGIN=http://localhost:3000
FRONTEND_APP_URL=http://localhost:3000

# Media on disk (survives container restart if this path is a volume). Object storage is still out of scope.
UPLOAD_DIR=./uploads/media

# Database (PostgreSQL 16+)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/webedu?schema=public

# Security
JWT_SECRET=replace_this_with_a_secure_random_key_min_32_characters

# Email / Password Reset (Resend SMTP Relay)
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key_here
# Với tài khoản Resend chưa verify domain riêng, dùng tạm domain test: onboarding@resend.dev
SMTP_FROM="Trung Tâm TD Hán Ngữ <onboarding@resend.dev>"

# Default AI Essay Grading Provider (optional; Superadmin can override/toggle at /superadmin/settings)
DEFAULT_AI_PROVIDER=CUSTOM
DEFAULT_AI_BASE_URL=https://modelapi.vn/v1
DEFAULT_AI_MODEL=gpt-5.6-luna
DEFAULT_AI_API_KEY=
